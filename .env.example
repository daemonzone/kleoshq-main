# Settings of the local Docker stack (docker-compose.yml).
# Copy to .env to change them; every value below is the default.

# --- SiteWitness plugin -> sitewitness-agent --------------------------------
# A source of the Supabase `sources` table (channel sitewitness): its id is the
# [slug] of the webhook URL, its `hmac` is the secret. Left empty, the plugin
# is installed and active but has no webhook: set it in Settings > SiteWitness.
# After changing these: docker compose up wp-setup
SITEWITNESS_SOURCE_ID=
SITEWITNESS_HMAC_SECRET=
SITEWITNESS_SCHEDULE=daily

# --- Host ports --------------------------------------------------------------
WORDPRESS_PORT=8088
PUBLIC_WWW_PORT=4000
SITEWITNESS_AGENT_PORT=4001
WOOCOMMERCE_AGENT_PORT=4002
INGESTION_PROCESSOR_PORT=4003
INGESTION_ANALYZER_PORT=4004
MYSQL_PORT=3307
POSTGRES_PORT=5433

# --- WordPress ---------------------------------------------------------------
WP_TITLE=KleosHQ test site
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin_dev_password
WP_ADMIN_EMAIL=admin@example.com

MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

# --- Event store (PostgreSQL / TimescaleDB) ----------------------------------
POSTGRES_USER=kleos
POSTGRES_PASSWORD=kleos_dev_password
POSTGRES_DB=kleoshq_development

# --- Analyzer AI endpoint, running on the host --------------------------------
# Claude Code bridge (npm run bridge): port 11435 — Ollama: port 11434
AI_API_URL=http://host.docker.internal:11435/v1/chat/completions
